<!DOCTYPE html>
<%- include('../modules/head', {title:"Explore"}) %>

    <body>
        <div class="content">
            <img src="/assets/svg/flatlinkTextLogo.svg" alt="" class="topLeftLogoText">

            <a href="">
                <img src="/assets/svg/preferences.svg" class="topRightButton" alt="">
            </a>
            <span>

            </span>
            <div class="foreground bottomNav">
                <div class="foregroundTop">
                    <div class="oval"></div>
                </div>

                <div class="innerNav">
                    <div class="navElement">
                        <center>
                            <img src="/assets/svg/exploreFull.svg" alt="">
                            <p>Explore</p>
                        </center>
                    </div>
                    <a href="/user/likes">
                        <div class="navElement">
                            <center>
    
                                <img src="/assets/svg/heartEmpty.svg" alt="">
                                <p>Likes</p>
                            </center>
                        </div>
                    </a>
                <a href="/user/account">
                    <div class="navElement">
                        <center>

                            <img src="/assets/svg/accountEmpty.svg" alt="">
                            <p>Account</p>
                        </center>
                    </div>
                </a>

                </div>

            </div>
        </div>
        <%- include('../modules/footer', { minHeight: 0.89, hide: true}) %>

    </body>

    </html>

    <script>

$.ajax({
    url: '<%=process.env.apiUrl%>/matchingService/getMatch',
    type: 'POST',
    async: true,
    cache: false,
    crossDomain: true,
    data: {
        "flatlinkAuth": getCookie('flatlinkAuth'),
        "currentId": "",
        "matchAmount": 10
    },
    success: function (data, status, xhr) {
        if (data) {
            console.log(data)
       if (data.success == true) {
        var matchpercents = "<br><br><br>";
        data.providers.forEach(element => {
            matchpercents = matchpercents+" <br>"+element.score.matchPercent+"% - "+element.provider.id;
        });
        $('span').html(matchpercents)
        }
        if (data.success == false) {
            $('.errorMessage').show()
            $('.errorMessage .messageText').html(errorMessages[data.error])
        }
    }

    },
    error: function (jqXHR, textStatus, err) {
        $('.errorMessage').show()
        $('.errorMessage .messageText').html("")
}
});

    </script>