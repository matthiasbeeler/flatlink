<!DOCTYPE html>
<%- include('../modules/head', {title:"Explore"}) %>

    <body>
        <div class="content">
            <img src="/assets/svg/flatlinkTextLogo.svg" alt="" class="topLeftLogoText">

            <a href="">
                <img src="/assets/svg/preferences.svg" class="topRightButton" alt="">
            </a>
            <div class="spacing10"></div>
            <div class="spacing10"></div>

            <div class="matches">
                <div class="matchContainer">
                    <div class="providerSection loading notEmpty grayShadowBoldNoOffset id${element.provider.id}">

                    </div>
                </div>
                <div class="buttonSection">
                    <div class="backButton matchButton grayShadowBoldNoOffset">
                        <img src="/assets/svg/backIcon.svg" alt="">
                    </div>
                    <div onclick="dislike()" class="dislikeButton matchButton grayShadowBoldNoOffset">
                        <img src="/assets/svg/dislikeIcon.svg" alt="">
                    </div>
                    <div class="moreInfoButton matchButton grayShadowBoldNoOffset">
                        <img src="/assets/svg/moreInfoIcon.svg" alt="">

                    </div>
                    <div onclick="like()" class="likeButton matchButton grayShadowBoldNoOffset">
                        <img src="/assets/svg/likeIcon.svg" alt="">
                    </div>
                </div>
            </div>
            <div class="spacing10"></div>
            <div class="spacing10"></div>
            <div class="spacing10"></div>
            <div class="spacing10"></div>

            <div class="foreground bottomNav">
                <div class="foregroundTop">
                    <div class="oval"></div>
                </div>
                <div class="innerForeground">
                    <div class="innerNav">
                        <div class="navElement">
                            <center>
                                <img src="/assets/svg/exploreFull.svg" alt="">
                                <img src="/assets/svg/exploreEmpty.svg" style="display: none;" alt="">
                                <p>Explore</p>
                            </center>
                        </div>
                        <a href="/user/likes">
                            <div class="navElement">
                                <center>

                                    <img src="/assets/svg/heartEmpty.svg" alt="">
                                    <img src="/assets/svg/heartFull.svg" style="display: none;" alt="">
                                    <p>Likes</p>
                                </center>
                            </div>
                        </a>
                        <a href="/user/account">
                            <div class="navElement">
                                <center>

                                    <img src="/assets/svg/accountEmpty.svg" alt="">
                                    <img src="/assets/svg/accountFull.svg" style="display: none;" alt="">
                                    <p>Account</p>
                                </center>
                            </div>
                        </a>

                    </div>
                </div>

            </div>

        </div>
        <%- include('../modules/footer', { minHeight: 0.89, hide: true}) %>

    </body>

    </html>

    <script>



        let potentialMatches;
        let seenProviders = [];
        function like() {
            $('.matchButton').addClass('disabled');
            $('.matchButton').attr('onclick', '');
            console.log(potentialMatches)
            $('.id' + potentialMatches[0].provider.id + " .matchOverlay").css('opacity', '1');
            function animateAndDelete(cardElement) {
               
                cardElement.classList.add('animateLike');

                cardElement.addEventListener('animationend', function () {
                    cardElement.remove();
                    var obj = `<div style="z-index:8;" class="providerSection loading notEmpty grayShadowBoldNoOffset">
                    </div>`;
            $('.matchContainer').append(obj);

            potentialMatches = potentialMatches.slice(1, potentialMatches.length);
            generateNewCard()
            getNewMatch(seenProviders);
                }, { once: true });
            }
            postLike(potentialMatches[0].provider.id)
            const card = document.querySelector('.id' + potentialMatches[0].provider.id);
            animateAndDelete(card);
           
           
        }
        function dislike() {
            $('.id' + potentialMatches[0].provider.id + " .dislikeOverlay").css('opacity', '1');
            function animateAndDelete(cardElement) {
               
                cardElement.classList.add('animateDislike');
              
                cardElement.addEventListener('animationend', function () {
                    cardElement.remove();
                    var obj = `<div style="z-index:8;" class="providerSection loading notEmpty grayShadowBoldNoOffset">
                    </div>`;
            $('.matchContainer').append(obj);

            potentialMatches = potentialMatches.slice(1, potentialMatches.length);
            generateNewCard()
            getNewMatch(seenProviders);
                }, { once: true });
            }
            postDislike(potentialMatches[0].provider.id)
            const card = document.querySelector('.id' + potentialMatches[0].provider.id);
            animateAndDelete(card);

        }


        function postLike(providerId) {
            console.log(providerId)
            $.ajax({
                url: '<%=process.env.apiUrl%>/matchingService/likeMatch',
                type: 'POST',
                async: true,
                cache: false,
                crossDomain: true,
                data: {
                    "flatlinkAuth": getCookie('flatlinkAuth'),
                    "providerId": providerId,
                },
                success: function (data, status, xhr) {
                    if (data) {
                        if (data.success == true) {
                            console.log("success")
                        }
                        if (data.success == false) {
                            console.log(data)
                        }
                    }

                },
                error: function (jqXHR, textStatus, err) {
                    $('.errorOverlay').show()
                    setTimeout(() => {
                        window.location.reload();
                    }, 30000);

                }
            });

        }


        function postDislike(providerId) {
            $.ajax({
                url: '<%=process.env.apiUrl%>/matchingService/dislikeMatch',
                type: 'POST',
                async: true,
                cache: false,
                crossDomain: true,
                data: {
                    "flatlinkAuth": getCookie('flatlinkAuth'),
                    "providerId": providerId,
                },
                success: function (data, status, xhr) {
                    if (data) {
                        if (data.success == true) {
                            console.log("success")
                        }
                        if (data.success == false) {
                            console.log(data)
                        }
                    }

                },
                error: function (jqXHR, textStatus, err) {
                    $('.errorOverlay').show()
                    setTimeout(() => {
                        window.location.reload();
                    }, 30000);

                }
            });

        }


        function getNewMatch() {
            $.ajax({
                url: '<%=process.env.apiUrl%>/matchingService/getMatch',
                type: 'POST',
                async: true,
                cache: false,
                crossDomain: true,
                data: {
                    "flatlinkAuth": getCookie('flatlinkAuth'),
                    "currentId": JSON.stringify(seenProviders),
                    "matchAmount": 1
                },
                success: function (data, status, xhr) {
                    if (data) {
                        if (data.success == true) {
                           if(data.providers.length == 0) return;
                            potentialMatches.push(data.providers[0])
                            seenProviders.push(data.providers[0].provider.id)
                            potentialMatches.sort((a, b) => b.score.score - a.score.score);
                        }
                        if (data.success == false) {
                            $('.errorMessage').show()
                            $('.errorMessage .messageText').html(errorMessages[data.error])
                        }
                    }

                },
                error: function (jqXHR, textStatus, err) {
                    $('.errorOverlay').show()
                    setTimeout(() => {
                        window.location.reload();
                    }, 30000);

                }
            });

        }

        $.ajax({
            url: '<%=process.env.apiUrl%>/matchingService/getMatch',
            type: 'POST',
            async: true,
            cache: false,
            crossDomain: true,
            data: {
                "flatlinkAuth": getCookie('flatlinkAuth'),
                "currentId": "[]",
                "matchAmount": 5
            },
            success: function (data, status, xhr) {
                if (data) {
                    if (data.success == true) {
                        potentialMatches = data.providers.map((provider, index) => ({
                            provider: provider.provider,
                            score: provider.score
                        }));
                        potentialMatches.forEach(element => {
                            seenProviders.push(element.provider.id)
                        });
                        generateNewCard()
                    }
                    if (data.success == false) {
                        $('.errorMessage').show()
                        $('.errorMessage .messageText').html(errorMessages[data.error])
                    }
                }

            },
            error: function (jqXHR, textStatus, err) {
                $('.errorOverlay').show()
                setTimeout(() => {
                    window.location.reload();
                }, 30000);

            }
        });

        function noMatches() {
            var obj = `

<div class="providerSection noMatches grayShadowBoldNoOffset">
   <img src="/assets/svg/noMatches.svg">

</div>


`
$('.providerSection.loading.notEmpty').replaceWith(obj)
        }

        function generateNewCard() {
            var matchpercents = "<br><br><br>";
            if(potentialMatches.length == 0) return noMatches();
                        var element = potentialMatches[0];
                        console.log(element.provider.images, potentialMatches)
                        $('.providerSection .flatImage').attr('src', `<%=process.env.apiUrl%>/accountService/uploads/providerImages/${element.provider.images[0]}?flatlinkAuth=${getCookie('flatlinkAuth')}`)
            
                        var gendPreference = "";
                        if (element.provider.genderPreference == "female") gendPreference = "Nur Frauen";
                        if (element.provider.genderPreference == "male") gendPreference = "Nur Männer";
                        if (element.provider.genderPreference == "intersex") gendPreference = "Nur Intersex";
                        if (element.provider.genderPreference == "none") gendPreference = "";


                        var obj = `
 <div class="providerSection loading notEmpty grayShadowBoldNoOffset id${element.provider.id}">
                    <img class="flatImage" src="<%=process.env.apiUrl%>/accountService/uploads/providerImages/${element.provider.images[0]}?flatlinkAuth=${getCookie('flatlinkAuth')}" alt=''>
                    <div class="imageOverlay">
                    </div>
                    <div class="dislikeOverlay">
                        <img src="/assets/svg/dislikeIcon.svg">
                    </div>
                    <div class="matchOverlay">
                        <img src="/assets/svg/likeIcon.svg">
                    </div>
                    <div class="topDetails">
                        <div class="location">
                            <div class="sideIcon"><img src="/assets/svg/location.svg" alt="">
                            </div>
                            <div class="title descriptionText">${element.provider.plz}, ${element.provider.place}</div>

                        </div>
                        <div class="genderPreference">
                            <div class="title descriptionText">${gendPreference}</div>
                        </div>
                    </div>
                    <div class="bottomDetails">
                        <div class="price">
                            <div class="sideIcon"><img src="/assets/svg/moneyBank.svg" alt="">
                            </div>
                            <div class="title descriptionText">400 chf/monat</div>

                        </div>
                        <div class="flatmates">
                            <div class="sideIcon"><img src="/assets/svg/people.svg" alt=""></div>
                            <div class="title descriptionText">3 Mitbewohner:innen</div>

                        </div>
                    </div>
                </div>
            `;
            $('.providerSection.loading.notEmpty').replaceWith(obj)

            $('.matchButton').removeClass('disabled');
            $('.matchButton.likeButton').attr('onclick', 'like()');
            $('.matchButton.dislikeButton').attr('onclick', 'dislike()');
            $('.matchButton.returnButton').attr('onclick', 'return()');
        }
    </script>