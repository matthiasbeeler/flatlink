                            <script>


                                const output = document.querySelector(".output")
                                const input = document.querySelector("#file")
                                let imagesArray = []
                                function displayImages() {
                                    output.style.display = "block"

                                    let images = ""
                                    console.log(imagesArray)
                                    imagesArray.forEach((image, index) => {
                                        images += `<div class="image">
    <img src="${URL.createObjectURL(image)}" alt="image">
    <span onclick="deleteImage(${index})"><img src="/assets/svg/close.svg"></span>
  </div>`
                                        output.innerHTML = images

                                    })
                                }
                                function deleteImage(index) {
                                    imagesArray.splice(index, 1)
                                    displayImages()
                                }

                                input.addEventListener("change", () => {
                                    const files = input.files
                                    imagesArray = [];
                                    for (let i = 0; i < files.length; i++) {
                                        imagesArray.push(files[i])
                                    }
                                    displayImages()

                                })


                                //verify address
                                async function verifyAddress(street, plz, place) {
                                    try {
                                        const query = encodeURIComponent(`${street}, ${plz} ${place}`);
                                        // Nominatim api call to verify
                                        const url = `https://nominatim.openstreetmap.org/search?q=${query}&format=json&limit=1`;
                                        const response = await fetch(url, {});
                                        const data = await response.json();
                                        if (data.length == 0) {
                                            return false;
                                        }
                                        return true;

                                    } catch (error) {
                                        console.error('Error verifying address:', error);
                                        return {
                                            isValid: false,
                                            message: 'Error occurred while verifying address'
                                        };
                                    }
                                }

                                $(".providerForm").submit(async function (e) {
                                    e.preventDefault();

                                    $(".submitButton").addClass('buttonLoading');
                                    $('.submitButton').attr('onclick', '');
                                    var formdata = new FormData(document.querySelector('form'));
                                    if(await verifyAddress(formdata.get('street'), formdata.get('plz'), formdata.get('place')))
                                {
                                   
                                
                                    formdata.append('flatlinkAuth', getCookie('flatlinkAuth'));
                                    for (let i = 0; i < imagesArray.length; i++) {
                                        formdata.append("files[]", imagesArray[i]);

                                    }
                                    var imageCount = 0;
                                    $.ajax({
                                        url: '<%=process.env.apiUrl%>/matchingService/updateProviderPreferences',
                                        type: 'POST',
                                        cache: false,
                                        processData: false,  // Prevent jQuery from processing the data
                                        contentType: false,
                                        crossDomain: true,
                                        data: formdata,
                                        success: function (data) {
                                            if (data.success == true) {
                                                window.location = "/user/account";
                                            }
                                            if (data.success == false) {
                                                $('.submitButton').attr('onclick', $('.submitButton').data('onclick'));
                                                $(".submitButton").removeClass('buttonLoading');
                                                $(".button").show();
                                                $('.message').show()
                                                $('.message').html(data.message)
                                            }
                                        },
                                        error: function (xhr) {
                                            $('.submitButton').attr('onclick', $('.submitButton').data('onclick'));

                                            alert('Request Status: ' + xhr.status + ' Status Text: ' + xhr.statusText + ' ' + xhr.responseText);
                                        }
                                    });

                                }else{
                                    window.scrollTo({ top: 0, behavior: 'smooth' });
                                    $('.submitButton').attr('onclick', $('.submitButton').data('onclick'));
                                                $(".submitButton").removeClass('buttonLoading');
                                                $(".button").show();
                                                $('.message').show()
                                                $('.message').html("Bitte gib eine gültige Adresse ein")
                                }
                                })
                            </script>
