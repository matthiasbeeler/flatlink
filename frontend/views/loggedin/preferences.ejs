    <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.7.1/leaflet.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.7.1/leaflet.css" />

    <script>

        const numSelect = {
            1: "one",
            2: "tow",
            3: "three",
            4: "four",
            5: "five",
            6: "six",
            7: "seven",
            8: "eight",
            9: "nine",
            10: "ten"
        }

        function provider(data) {

            $('.provider').show()
            $('.provider .genderPreference .' + data.personalData.genderPreference).click()
            $('.provider #genderPreference').val(data.personalData.genderPreference)

            $('.provider .cleanliness .' + numSelect[data.personalData.cleanliness]).click()
            $('.provider #cleanliness').val(data.personalData.cleanliness)

            $('.provider .quietness .' + numSelect[data.personalData.quietness]).click()
            $('.provider #quietness').val(data.personalData.quietness)
            $('.provider .accessibility .' + numSelect[data.personalData.accessibility]).click()
            $('.provider #accessibility').val(data.personalData.accessibility)

            $('.provider .flatmates .' + numSelect[data.personalData.flatmates]).click()
            $('.provider #flatmates').val(data.personalData.flatmates)
            $('.provider #roomSize').val(Number(data.personalData.roomSize))
            $('.provider #flatSize').val(Number(data.personalData.flatSize))

            if (data.personalData.balcony == true) {
                $('.provider .balcony .one').click()
            } else {
                $('.provider .balcony .two').click()
            }
            if (data.personalData.internet == true) {
                $('.provider .internet .one').click()
            } else {
                $('.provider .internet .two').click()
            }
            if (data.personalData.washer == true) {
                $('.provider .washer .one').click()
            } else {
                $('.provider .washer .two').click()
            }
            $('.provider #street').val(data.personalData.street)
            $('.provider #zip').val(data.personalData.plz)
            $('.provider #place').val(data.personalData.place)
            $('.provider #price').val(data.personalData.price)
            $('.provider .food .' + data.personalData.food).click()
            $('.provider #food').val(data.personalData.food)
            $('.provider #description').val(data.personalData.description)


            async function addImageToInput(url) {
                try {
                    const response = await fetch(url);
                    const blob = await response.blob();
                    const fileName = url.split('/').pop();
                    const file = new File([blob], fileName, { type: blob.type });

                    const dataTransfer = new DataTransfer();

                    // Add existing files
                    for (let i = 0; i < document.querySelector('#file').files.length; i++) {
                        dataTransfer.items.add(document.querySelector('#file').files[i]);
                    }

                    // Add the new file
                    dataTransfer.items.add(file);

                    // Set the new FileList to the input
                    document.querySelector('#file').files = dataTransfer.files;

                    // Trigger change event
                    const event = new Event('change');
                    console.log("hi")
                    document.querySelector('#file').dispatchEvent(event);
                } catch (error) {
                    console.error(`Error adding image from ${url}:`, error);
                }
            }

            const imageUrl = 'https://example.com/image.jpg';


            for (const id of data.personalData.images) {
                var url = `<%=process.env.apiUrl%>/accountService/uploads/providerImages/${id}?flatlinkAuth=${getCookie('flatlinkAuth')}`
                addImageToInput(url)
            }
            $('.searcher').remove()
        }

        function searcher(data) {
            $('.searcher').show()
            $('.genderPreference .' + data.personalData.genderPreference).click()
            $('#genderPreference').val(data.personalData.genderPreference)

            $('.cleanliness .' + numSelect[data.personalData.cleanliness]).click()
            $('#cleanliness').val(data.personalData.cleanliness)

            $('.quietness .' + numSelect[data.personalData.quietness]).click()
            $('#quietness').val(data.personalData.quietness)
            $('.accessibility .' + numSelect[data.personalData.accessibility]).click()
            $('#accessibility').val(data.personalData.accessibility)

            $('.flatmates .' + numSelect[data.personalData.flatmates]).click()
            $('#flatmates').val(data.personalData.flatmates)

            $('.roomSize .a' + data.personalData.roomSize.replace('-', '').replace('+', '')).click()
            $('#roomSize').val(data.personalData.roomSize)

            $('.flatSize .a' + data.personalData.flatSize.replace('-', '').replace('+', '')).click()
            $('#flatSize').val(data.personalData.flatSize)

            $('.balcony .' + numSelect[data.personalData.balcony]).click()
            $('#balcony').val(data.personalData.balcony)

            $('.internet .' + numSelect[data.personalData.internet]).click()
            $('#internet').val(data.personalData.internet)

            $('.washer .' + numSelect[data.personalData.washer]).click()
            $('#washer').val(data.personalData.washer)

            var map = L.map('map').setView([46.8182, 8.2275], 8);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
            }).addTo(map);

            var marker;
            var marker = L.marker([data.personalData.preferredLat, data.personalData.preferredLon]).addTo(map);
            $('#location').val(data.personalData.preferredLat + "," + data.personalData.preferredLon)

            map.on('click', function (e) {
                if (marker) {
                    map.removeLayer(marker);
                }
                marker = L.marker(e.latlng).addTo(map);
                var lat = e.latlng.lat.toFixed(9);
                var lng = e.latlng.lng.toFixed(9);
                $('#location').val(lat + "," + lng)
            });

            $('.connections .' + numSelect[data.personalData.connections]).click()
            $('#connections').val(data.personalData.connections)

            $('#budget').val(data.personalData.budget)

            $('.gender .' + data.personalData.gender).click()
            $('#gender').val(data.personalData.gender)
            $('.food .' + data.personalData.food).click()
            $('#food').val(data.personalData.food)
            $('#description').val(data.personalData.description)
            $('.provider').remove()

        }
        $.ajax({
            url: '<%=process.env.apiUrl%>/accountService/getAllData',
            type: 'POST',
            async: true,
            cache: false,
            crossDomain: true,
            data: {
                "flatlinkAuth": getCookie('flatlinkAuth'),
            },
            success: function (data, status, xhr) {
                console.log(data)
                if (data.success == true) {
                    $('.hideSuccess').hide()
                    if (data.userData.userType == "searcher") searcher(data);
                    if (data.userData.userType == "provider") provider(data)

                }
            }
        })


        function select(element) {
            $(element).parents().children().toArray().forEach(el => {
                $(el).removeClass('selected');
            });
            $(element).addClass('selected');
            if ($(element).parents().hasClass('selectInput3')) return $(element).parents().children('.selectField').val($(element).data('val'))
            if ($(element).parents().hasClass('selectInput4')) return $(element).parents().children('.selectField').val($(element).data('val'))

            $(element).parents().children('.selectField').val($(element).html())
        }


    </script>