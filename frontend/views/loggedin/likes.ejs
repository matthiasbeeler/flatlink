<!DOCTYPE html>
<%- include('../modules/head', {title:"Likes"}) %>

    <body>
        <div class="content">
            <img src="/assets/svg/yourLikes.svg" alt="" class="topLeftLogoText  topLeftLogoTextLikes">

            <div class="spacing10 hideMatchDetail"></div>
            <div class="spacing10 hideMatchDetail"></div>
           <div class="spacing10 hideMatchDetail"></div>
           <%- include('../modules/matchDetailLikes') %>
           <div class="spacing10 hideSuccess"></div>
           <div class="spacing10 hideSuccess"></div>
           <div class="spacing10 hideSuccess "></div>
           <div class="spacing10 hideSuccess"></div>

           <div class="lds-ripple hideSuccess ">
               <div></div>
               <div></div>
             </div>
          <div class="likeContainer hideMatchDetail">

          </div>
           <div class="spacing10 hideMatchDetail"></div>
           <div class="spacing10 hideMatchDetail"></div>
           <div class="spacing10"></div>

            <div class="foreground bottomNav hideMatchDetail">
                <div class="foregroundTop">
                    <div class="oval"></div>
                </div>
                <div class="innerForeground">
                <div class="innerNav">
                    <%if(userType == "searcher"){%>
                        <div class="navElement">
                            <center>
                                <img src="/assets/svg/exploreEmpty.svg" alt="">
                                <p>Explore</p>
                            </center>
                        </div>
                        <%}%>
                       
                        <div class="navElement">
                            <center>
    
                                <img src="/assets/svg/heartEmpty.svg" style="display: none;" alt="">
                                <img src="/assets/svg/heartFull.svg" alt="">
                                <p>Likes</p>
                            </center>
                        </div>
                <a href="/user/account">
                    <div class="navElement">
                        <center>

                            <img src="/assets/svg/accountEmpty.svg" alt="">
                            <img src="/assets/svg/accountFull.svg" style="display: none;" alt="">
                            <p>Account</p>
                        </center>
                    </div>
                </a>

                </div>
            </div>

            </div>

        </div>
        <%- include('../modules/footer', { minHeight: 0.89, hide: true}) %>

    </body>

    </html>

    <script>


function moreInfo(data) {
            loadData(data)
            $('.hideMatchDetail').css('opacity', '0')
            setTimeout(() => {
                $('.hideMatchDetail').hide()
                $('.moduleContent').show()
            $('.moduleContent').css('opacity', '1')
            }, 300);
        }


        function closeInfo() {
            $('.moduleContent').css('opacity', '0')
            setTimeout(() => {
                $('.moduleContent').hide()
                $('.hideMatchDetail').show()
            $('.hideMatchDetail').css('opacity', '1')
            }, 300);
        }
var likeData = {}
$.ajax({
    url: '<%=process.env.apiUrl%>/matchingService/getLikedMatch',
    type: 'POST',
    async: true,
    cache: false,
    crossDomain: true,
    data: {
        "flatlinkAuth": getCookie('flatlinkAuth'),
    },
    success: function (data, status, xhr) {
        if (data) {
            console.log(data)
       if (data.success == true) {
        data.logs.forEach(element => {
            likeData["like"+element.providerId] = element.providerPreference;
            $('.hideSuccess').hide()
        var obj = `

                     <div class="like${element.providerId} likeElement grayShadowNoOffset" onclick='moreInfo("like${element.providerId}")'>
            <div class="likeImageLeft loading notEmpty">
                <img src="<%=process.env.apiUrl%>/accountService/uploads/providerImages/${element.providerPreference.images[0]}?flatlinkAuth=${getCookie('flatlinkAuth')}" alt="">
            </div>
            <div class="textContent">
            <div class="likeAddress" id="likeAddress">
               ${element.providerPreference.street}, ${element.providerPreference.plz} ${element.providerPreference.place}
            </div>
            <div class="likeInfo">
                ${element.providerPreference.price}chf/monat · ${element.providerPreference.flatmates} Personen
            </div>
        </div>
           </div>
               
                <div class="spacing8"></div>
            `
            $('.likeContainer').append(obj)
        });
        }
        if (data.success == false) {
            $('.errorMessage').show()
            $('.errorMessage .messageText').html(errorMessages[data.error])
        }
    }

    },
    error: function (jqXHR, textStatus, err) {
        $('.errorOverlay').show()
        setTimeout(() => {
            window.location.reload();
        }, 30000);

}
});

    </script>