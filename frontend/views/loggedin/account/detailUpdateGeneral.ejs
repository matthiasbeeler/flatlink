<!DOCTYPE html>
<%- include('../../modules/head', {title:"Account"}) %>

    <body>
        <div class="content">
            <a href="/user/account" class="backButtonLink">
            <div class="backButton">
                <img src="/assets/svg/backIcon.svg" alt="">
            </div>
        </a>

        <div class="topTitle title topTitleSettings">Vorname</div>


            <div class="foreground">
                <div class="foregroundTop">
                    <div class="oval"></div>
                </div>
                <div class="innerForeground">
                <form id="mainForm" method="post" action=""> 
                    <div class="message orangeShadowNoOffset">
                    </div>
                    <input type="email" name="email" placeholder="eMail"
                        onchange="$(this).css('border', '1px solid var(--inputBorder)');"
                        oninvalid=" $(this).css('border', '1px solid red');" required>
                    <div class="spacing8">

                    </div>
                    <input type="password" name="password" required placeholder="Password"
                    onchange="$(this).css('border', '1px solid var(--inputBorder)');"
                        oninvalid=" $(this).css('border', '1px solid red');"
                       >
                       <div class="spacing8"></div>
                       <div class="buttonDiv button submitButton" data-onclick="$('#submitButton').click()" onclick="$('#submitButton').click();">
                           <div class="buttonText">Log in</div>
                           </div>
                       <input type="submit" id="submitButton" value="submit" style="display: none;">

                </form>

           
                    
                <div class="spacing5"></div>
                <center>
                    <a href="" class="centerLink">Passwort vergessen</a>
                </center>
                <div class="spacing5"></div>

                <div class="seperator"></div>
                <div class="spacing5"></div>
                <div class="spacing3"></div>

                <div class="buttonDiv button lightButton" onclick="window.location = '/signup'"> 
                    <div class="buttonText">Sign up</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

        <%- include('../../modules/footer', { minHeight: 0.4, hide: true}) %>

    </body>

    </html>
    <script>



// Usage


$.ajax({
    url: '<%=process.env.apiUrl%>/accountService/accountData',
    type: 'POST',
    async: true,
    cache: false,
    crossDomain: true,
    data: {
        "flatlinkAuth": getCookie('flatlinkAuth')
    },
    success: function (data, status, xhr) {
        if (data) {
            console.log(data)
       if (data.success == true) {
        setCookie("flatlinkAuth", data.token)
        $(".emptyLoading").removeClass("emptyLoading");

         $('.firstName').html(data.userData.firstName)
         $('.phonenumber').html(data.userData.phonenumber)
         $('.lastName').html(data.userData.lastName)
         $('.emailAddress').html(data.userData.email)
         if(data.userType == "searcher"){
            $('.occupation').html(data.personalData.occupation)
            $('.genderDetail').html(`<img src="/assets/svg/${data.personalData.gender}.svg" alt="">`);
            $('.profileImage img').attr(`src`, `<%=process.env.apiUrl%>/accountService/uploads/searcherImages/${data.userId}?flatlinkAuth=${data.token}`)

         }
         if(data.userType == "provider"){
            $('.profileImage img').attr(`src`, `/assets/svg/providerPlaceholder.svg`)

            $('.occupationDetail').html("@"+data.personalData.place)
            $('.genderDetail').html(`<span class="noAnimation" id="flatmates">${data.personalData.flatmates}</span>  <img src="/assets/svg/people.svg" alt="">`);
            $('.genderDetail').addClass('flatmates noAnimation')
            $('.customTitle').html("Adresse")
            $('.customContent').html(`${data.personalData.street}, ${data.personalData.place} ${data.personalData.plz}`)

         }
         adjustFontSize('nameDetail', 12, 80, 2);
   adjustFontSize('occupationDetail', 12, 80, 2);
   adjustFontSize('flatmates', 12, 80, 2);

            $('.accountPageProfileImage').css('background-image',
                            `url(<%=process.env.apiUrl%>/uploads/profileImages/${data.userData.profileImage}?v=${data.userData.profileImageUpdate})`
                            )
        
        }
        if (data.success == false) {
            $('.errorMessage').show()
            $('.errorMessage .messageText').html(errorMessages[data.error])
        }
    }

    },
    error: function (jqXHR, textStatus, err) {
        $('.errorOverlay').show()
        setTimeout(() => {
            window.location.reload();
        }, 30000);
}
});


    </script>