<!DOCTYPE html>
<%- include('../../modules/head', {title:"Account"}) %>

    <body>
        <div class="content">
            <a href="/user/account" class="backButtonLink">
            <div class="backButton">
                <img src="/assets/svg/backIcon.svg" alt="">
            </div>
        </a>
<%if(updateType == "phonenumber"){%>
    <%- include('../../modules/phonenumberUpdate') %>

        <%}%>



        <%if(updateType == "email"){%>
            <%- include('../../modules/emailUpdate') %>

            <%}%>

            <%if(updateType == "job"){%>
                <%- include('../../modules/jobUpdate') %>

                <%}%>


                <%if(updateType == "password"){%>
                    <%- include('../../modules/passwordUpdate') %>

                    <%}%>
            


    </div>

        <%- include('../../modules/footer', { minHeight: 0.4, hide: true}) %>

    </body>

    </html>
    <script>
console.log("<%=updateType%>")
$("#mainForm").submit(function(e) {
        e.preventDefault();
        $('.phoneSelect').attr('disabled', false)
        $(".submitButton").addClass('buttonLoading');
        $('.submitButton').attr('onclick', '');
            var formdata = new FormData(document.querySelector('#mainForm'));
            formdata.append('type', '<%=updateType%>');
            formdata.append('flatlinkAuth', getCookie('flatlinkAuth'));
            $('.phoneSelect').attr('disabled', true)

        $.ajax({
            url: '<%=process.env.apiUrl%>/accountService/updateAccount',
            type: 'POST',
            cache: false,
            processData: false,  // Prevent jQuery from processing the data
            contentType: false, 
            crossDomain: true,
            data: formdata,
            success: function (data) {
                console.log(data)
                if (data.success == true) {
                    setCookie("flatlinkAuth", data.token)
                    window.location = "/user/account";
                }
                if (data.success == false) {
                    $('.submitButton').attr('onclick', $('.submitButton').data('onclick'));
                    $(".submitButton").removeClass('buttonLoading');
                    $(".button").show();
                    $('.message').show()
                    $('.message').html(data.message)
                }
            },
            error: function(xhr){
                $('.submitButton').attr('onclick', $('.submitButton').data('onclick'));

        alert('Request Status: ' + xhr.status + ' Status Text: ' + xhr.statusText + ' ' + xhr.responseText);
    }
        });

    })


    </script>