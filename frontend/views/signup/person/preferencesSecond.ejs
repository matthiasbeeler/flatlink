    <script>

const urlParams = new URLSearchParams(window.location.search);
      const myParam = urlParams.get('myParam');
      if(urlParams.get('error')) {
        const numSelect = {
          1: "one",
          2: "tow",
          3: "three",
          4: "four",
          5: "five",
          6: "six",
          7: "seven",
          8: "eight",
          9: "nine",
          10: "ten"
        }
        var data = JSON.parse(localStorage.getItem("signupData"));
        console.log(data.lastName)
        $('#accessibility').parent().children("."+data.accessibility).click()
        $('#accessibility').parent().children("."+numSelect[data.accessibility]).click()
        $('#flatmates').parent().children("."+numSelect[data.flatmates]).click()
        $('#flatmates').parent().children("."+numSelect[data.flatmates]).click()
        $('.message').show()
        $('.message').html('Es ist ein Fehler aufgetreten. Bitte überprüfe Deine Eingaben.')
      }



      function select(element){
        $(element).parents().children().toArray().forEach(el => {
          $(el).removeClass('selected');
        });
        $(element).addClass('selected');
        if($(element).parents().hasClass('selectInput3')) return $(element).parents().children('.selectField').val( $(element).data('val'))
        $(element).parents().children('.selectField').val( $(element).html())
      }
        function passwordWrong() {
            if(!pattern.test($('#password').val()) | $('#password').val()) $('#message').show();
            if($('#password').val() !== $('#passwordCheck').val()) $('#messageCheck').show()
            $('.submitButton').attr('onclick', $('.submitButton').data('onclick'));
            $(".submitButton").removeClass('buttonLoading');
        }

        $("form").submit(function(e) {
        e.preventDefault();
        $(".submitButton").addClass('buttonLoading');
        $('.submitButton').attr('onclick', '');
        document.querySelectorAll('.selectInput').forEach(element => {
          if($(element).children('input').val() =="") {
            $('.submitButton').attr('onclick', $('.submitButton').data('onclick'));
            $(".submitButton").removeClass('buttonLoading');
            $(element).css('border-color', 'red');
            return
          }
        });

        setTimeout(() => {
            var data = JSON.parse(localStorage.getItem("signupData"));
            data.accessibility = $('#accessibility').val().replace(/\s+/g, '');
            data.flatmates = $('#flatmates').val().replace(/\s+/g, '');
            data.roomSize = $('#roomSize').val().replace(/\s+/g, '');
            data.flatSize = $('#flatSize').val().replace(/\s+/g, '');
            localStorage.setItem("signupData", JSON.stringify(data));
            if(urlParams.get('error')) return window.location = '/signup/preferences/person/profile'

            window.location = '/signup/preferences/person/third'
        }, 500)
    })

    </script>