<!DOCTYPE html>
<%- include('../../modules/head', {title:"Deine Präfernzen"}) %>

    <body>
        <div class="content">
          <img src="/assets/svg/flatLinkLogo.svg" alt="" class="topLeftLogo">

          <div class="topTitle title stepTitle">
              Schritt 7/8
          </div>
          <br>
          <br>
            <p class="bigCenterTitle title">
             Deine Präferenzen
            </p>

            <div class="foreground">
                <div class="foregroundTop">
                    <div class="oval"></div>
                </div>
                <div class="spacing5"></div>
                <form>
                    <div class="message orangeShadowNoOffset">
                    </div>
                    <p class="selectLabel" for="selectInput">Wo wäre der Ideale Standort Deiner WG?</p>
                    <div class="spacing1"></div>
                    <div id="map"></div>
                    <input required type="text" name="location" id="location" style="display: none;" class="">
                    <div class="spacing8"></div>

                    <p class="selectLabel" for="selectInput">Wie wichtig sind Dir Anbindungen (Supermarkt, öV, usw.)?</p>
                    <div class="spacing1"></div>
                    <div class="selectInput"  onclick="$(this).removeAttr('style');">
                      <div class="selectElement one" onclick="select(this)">
                        1
                      </div>
                      <div class="selectElement two" onclick="select(this)">
                        2
                      </div>
                      <div class="selectElement three" onclick="select(this)">
                        3
                      </div>
                      <div class="selectElement four" onclick="select(this)">
                        4
                      </div>
                      <div class="selectElement five" onclick="select(this)">
                        5
                      </div>
                      <div class="selectElement six" onclick="select(this)">
                        6
                      </div>
                      <div class="selectElement seven" onclick="select(this)">
                        7
                      </div>
                      <div class="selectElement eight" onclick="select(this)">
                        8
                      </div>
                      <div class="selectElement nine" onclick="select(this)">
                        9
                      </div>
                      <div class="selectElement ten" onclick="select(this)">
                        10
                      </div>
                      <input required type="text" name="connections" id="connections" style="display: none;" class="selectField">
                    </div>
                    <label for="cleanliness"><div class="left">Gar nicht</div><div class="right">Sehr</div></label>
                    <div class="spacing5"></div>
                    <div class="spacing8"></div>
                    <p class="selectLabel" for="selectInput">Wie hoch ist Dein Budget (CHF)?</p>
                    <div class="spacing1"></div>
                    <input type="number" name="budget" required placeholder="Budget"
                    onchange="$(this).css('border', '1px solid var(--inputBorder)');"
                    oninvalid=" $(this).css('border', '1px solid red');" id="budget" autocomplete="family-name">
                   

                    <div class="spacing8"></div>
                    
               
                  <div class="spacing5"></div>
                  <div class="buttonDiv button submitButton" data-onclick="$('#submitButton').click()" onclick="$('#submitButton').click();">
                    <div class="buttonText">Weiter</div>
                    </div>
                <input type="submit" id="submitButton" value="submit" style="display: none;">
                    <div class="spacing5"></div>
                </form>
               

            </div>
        </div>
        <%- include('../../modules/footer',{ minHeight: 0.35, hide: true}) %>

    </body>

    </html>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.7.1/leaflet.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.7.1/leaflet.css" />

    <script>

//maps
var map = L.map('map').setView([46.8182, 8.2275], 8);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
        }).addTo(map);

        var marker;
        map.on('click', function(e) {
            if (marker) {
                map.removeLayer(marker);
            }
            marker = L.marker(e.latlng).addTo(map);
            var lat = e.latlng.lat.toFixed(9);
            var lng = e.latlng.lng.toFixed(9);
            $('#location').val(lat+","+lng)
      });

      function select(element){
        $(element).parents().children().toArray().forEach(el => {
          $(el).removeClass('selected');
        });
        $(element).addClass('selected');
        if($(element).parents().hasClass('selectInput3')) return $(element).parents().children('.selectField').val( $(element).data('val'))
        if($(element).parents().hasClass('selectInput4')) return $(element).parents().children('.selectField').val( $(element).data('val'))

        $(element).parents().children('.selectField').val( $(element).html())
      }
        function passwordWrong() {
            if(!pattern.test($('#password').val()) | $('#password').val()) $('#message').show();
            if($('#password').val() !== $('#passwordCheck').val()) $('#messageCheck').show()
            $('.submitButton').attr('onclick', $('.submitButton').data('onclick'));
            $(".submitButton").removeClass('buttonLoading');
        }

        $("form").submit(function(e) {
        e.preventDefault();
        $(".submitButton").addClass('buttonLoading');
        $('.submitButton').attr('onclick', '');
        document.querySelectorAll('.selectInput').forEach(element => {
          if($(element).children('input').val() =="") {
            $('.submitButton').attr('onclick', $('.submitButton').data('onclick'));
            $(".submitButton").removeClass('buttonLoading');
            $(element).css('border-color', 'red');
            return
          }
        });

        setTimeout(() => {
            var data = JSON.parse(localStorage.getItem("signupData"));
            data.preferredLat = $('#location').val().split(',')[0];
            data.preferredLon = $('#location').val().split(',')[1];
            data.connections = $('#connections').val().replace(/\s+/g, '');
            data.budget = $('#budget').val();
            localStorage.setItem("signupData", JSON.stringify(data));
            window.location = '/signup/preferences/person/profile'
        }, 500)
    })

    </script>