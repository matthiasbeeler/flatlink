<!DOCTYPE html>
<%- include('../modules/head', {title:"Signup"}) %>

    <body>
        <div class="content">
            <img src="/assets/svg/flatLinkLogo.svg" alt="" class="topLeftLogo">

            <div class="topTitle title stepTitle">
                Schritt 2/-
            </div>  
            <br>
            <br>
            <p id="nameTitle" class="bigCenterTitle title">
            </p>
            <script defer>
              $('#nameTitle').html("Hallo " + JSON.parse(localStorage.getItem("signupData")).firstName)
            </script>
            <div class="spacing10"></div>
            <div class="spacing10"></div>
            

            <div class="foreground">
                <div class="foregroundTop">
                    <div class="oval"></div>
                </div>
                <div class="spacing5"></div>
                <form>
                    <div class="message orangeShadowNoOffset">
                    </div>
                    <input type="text" name="lastName" required placeholder="Dein Nachname"
                        onchange="$(this).css('border', '1px solid var(--inputBorder)');"
                        oninvalid=" $(this).css('border', '1px solid red');" id="lastName" autocomplete="family-name">
                    <div class="spacing8"></div>
                    <select id="phoneCode" class="phoneSelect" name="select" id="" onchange="$(this).css('border', '1px solid var(--inputBorder)');"
                    oninvalid=" $(this).css('border', '1px solid red');" disabled autocomplete="tel-country-code">
                        <option value="+41">+41 </option>
                    </select>
                    <input type="tel" class="phoneInput" required placeholder="Deine Telefonnummer"
                    onchange="$(this).css('border', '1px solid var(--inputBorder)');" onkeyup="this.value = this.value.replace(/[^0-9-]/g, '');"
                    oninvalid=" $(this).css('border', '1px solid red');" id="phonenumber" autocomplete="tel">
                    <div class="spacing8"></div>

                    <input type="password" name="password" required placeholder="Passwort"
                    onchange="$(this).css('border', '1px solid var(--inputBorder)');"
                    oninvalid=" $(this).css('border', '1px solid red');" id="password" autocomplete="off" pattern="(?=.*\d)(?=.*[a-z])(?=.*[A-Z]).{8,}" title="Must contain at least one number and one uppercase and lowercase letter, and at least 8 or more characters">
                    <div class="spacing3"></div>
                    <div id="message" class="info passwordInfo">
                        <h3>Passwort muss folgendes enthalten:</h3>
                        <p id="letter" class="invalid">Ein <strong>Kleinbuchsten</strong></p>
                        <p id="capital" class="invalid">Ein <strong>Grossbuchstaben</strong></p>
                        <p id="number" class="invalid">Eine <strong>Nummer</strong></p>
                        <p id="length" class="invalid">Mindestens <strong>8 Zeichen</strong></p>
                      </div>
                <div class="spacing5"></div>

                <input type="password" name="passwordCheck" id="passwordCheck" required placeholder="Passwort wiederholen"
                onchange="$(this).css('border', '1px solid var(--inputBorder)');"
                oninvalid=" $(this).css('border', '1px solid red');" autocomplete="off" pattern="(?=.*\d)(?=.*[a-z])(?=.*[A-Z]).{8,}" title="Must contain at least one number and one uppercase and lowercase letter, and at least 8 or more characters"> 
                <div class="spacing3"></div>
               
                <div id="messageCheck" class="info passwordInfo">
                    <h3 class="invalid">Passwörter müssen übereinstimmen</h3>
                  </div>
                  <div class="spacing5"></div>
                  
                  <div class="buttonDiv button submitButton" data-onclick="$('#submitButton').click()" onclick="$('#submitButton').click();">
                    <div class="buttonText">Weiter</div>
                    </div>
                <input type="submit" id="submitButton" value="submit" style="display: none;">
                    
                </form>

            </div>
        </div>
        <%- include('../modules/footer',{ minHeight: 0.3, hide: true}) %>

    </body>

    </html>

    <script>
      const urlParams = new URLSearchParams(window.location.search);
      if(urlParams.get('error')) {
        var data = JSON.parse(localStorage.getItem("signupData"));
        console.log(data.lastName)
        $('#lastName').val(data.lastName)
        $('#phoneCode').val(data.phoneCode);
        $('#phonenumber').val(data.phonenumber);
        $('#phonenumber').val(data.phonenumber);
        $('.message').show()
        $('.message').html('Es ist ein Fehler aufgetreten. Bitte überprüfe Deine Eingaben.')
      }
        function passwordWrong() {
            if(!pattern.test($('#password').val()) | $('#password').val()) $('#message').show();
            if($('#password').val() !== $('#passwordCheck').val()) $('#messageCheck').show()
            $('.submitButton').attr('onclick', $('.submitButton').data('onclick'));
            $(".submitButton").removeClass('buttonLoading');
        }

        $("form").submit(function(e) {
        e.preventDefault();
        $(".submitButton").addClass('buttonLoading');
        $('.submitButton').attr('onclick', '');
        setTimeout(() => {
            pattern = /(?=.*\d)(?=.*[a-z])(?=.*[A-Z]).{8,}/;
            if(!pattern.test($('#password').val()) | $('#password').val() !== $('#passwordCheck').val()) return passwordWrong()

            var data = JSON.parse(localStorage.getItem("signupData"));
            data.lastName = $('#lastName').val();
            data.phoneCode = $('#phoneCode').val();
            data.phonenumber = $('#phonenumber').val();
            data.password = $('#password').val();
            localStorage.setItem("signupData", JSON.stringify(data));
            
            if(urlParams.get('error')) return window.location = '/signup/preferences/person/profile'
            return window.location = '/signup/preferences/typeOption'
        }, 500)
    })

    var passwordInput = document.getElementById("password");
    var passwordCheckInput = document.getElementById("passwordCheck");

var letter = document.getElementById("letter");
var capital = document.getElementById("capital");
var number = document.getElementById("number");
var length = document.getElementById("length");

// When the user clicks on the password field, show the message box
passwordInput.onfocus = function() {
  document.getElementById("message").style.display = "block";
}

// When the user clicks outside of the password field, hide the message box
passwordInput.onblur = function() {
  document.getElementById("message").style.display = "none";
}

// When the user starts to type something inside the password field
passwordInput.onkeyup = function() {
  // Validate lowercase letters
  var lowerCaseLetters = /[a-z]/g;
  if(passwordInput.value.match(lowerCaseLetters)) {
    letter.classList.remove("invalid");
    letter.classList.add("valid");
  } else {
    letter.classList.remove("valid");
    letter.classList.add("invalid");
}

  // Validate capital letters
  var upperCaseLetters = /[A-Z]/g;
  if(passwordInput.value.match(upperCaseLetters)) {
    capital.classList.remove("invalid");
    capital.classList.add("valid");
  } else {
    capital.classList.remove("valid");
    capital.classList.add("invalid");
  }

  // Validate numbers
  var numbers = /[0-9]/g;
  if(passwordInput.value.match(numbers)) {
    number.classList.remove("invalid");
    number.classList.add("valid");
  } else {
    number.classList.remove("valid");
    number.classList.add("invalid");
  }

  // Validate length
  if(passwordInput.value.length >= 8) {
    length.classList.remove("invalid");
    length.classList.add("valid");
  } else {
    length.classList.remove("valid");
    length.classList.add("invalid");
  }
}

passwordCheckInput.onkeyup = function() {
    if(passwordCheckInput.value == passwordInput.value) return document.getElementById("messageCheck").style.display = "none";
    document.getElementById("messageCheck").style.display = "block";
}
    </script>