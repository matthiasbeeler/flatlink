<div class="footer" <%if(hide == true){%>style="display:none;"<%}%>>
    <div class="footerText"><a href="/datenschutz" target="_blank">Datenschutzerklärung</a>
    </div>
    <div class="footerText"><a href="/impressum" target="_blank">Impressum</a>
    </div>
    <center>
        <div class="footerText">&copy; <a href="https://nyv.ch" target="_blank">nyv</a> 2024
        </div>
    </center>
</div>
<script defer>
  
    if (!localStorage.getItem('cookieNoticeAccepted')) {
     // If the notice has not been accepted, display it
     if(document.location.pathname == "/datenschutz" || document.location.pathname ==  "/impressum") return;
     document.querySelector('.cookieNoticeBackground').style.display = 'flex';
   }
   
   // Add an event listener to the cookie notice to handle the user accepting it
   document.querySelector('.dismiss-cookie-notice').addEventListener('click', function() {
     // Set the 'cookieNoticeAccepted' item in local storage
     localStorage.setItem('cookieNoticeAccepted', true);
     // Hide the cookie notice
     document.querySelector('.cookieNoticeBackground').style.display = 'none';
   });
  if(document.querySelector('.foreground')){
var minHeight = <%=minHeight%>;
if(document.querySelector('.foreground').clientHeight / window.innerHeight < 1-minHeight){
document.querySelector('.foreground').style.height = window.innerHeight*(1-minHeight)+"px";
}
if(document.querySelector(".foreground").offsetTop / window.innerHeight*0.5 < minHeight){
document.querySelector('.foreground').style.marginTop = window.innerHeight*minHeight-document.querySelector(".foreground").offsetTop+"px";
}

}
     </script>
