    <script>




// Usage

var numArray = ['one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eigth', 'nine', 'ten'];

function loadData(providerDataId) {
  var provider = likeData[providerDataId];
  console.log(likeData[providerDataId])
    $('.selectElement').removeClass('selected')
    $('.carouselSlide').remove()
    $('.dot').remove()
    const imageSources =  provider.images;
     let currentIndex = 0;
        const carouselTrack = document.querySelector('.carouselTrack');
        const dotsContainer = document.querySelector('.dots');
        const carouselContainer = document.querySelector('.carouselContainer');

        let touchStartX = 0;
        let touchEndX = 0;

        function createSlides() {
            imageSources.forEach((src, index) => {
                const slide = document.createElement('div');
                slide.classList.add('carouselSlide');
                const img = document.createElement('img');
                img.src = `<%=process.env.apiUrl%>/accountService/uploads/providerImages/${src}?flatlinkAuth=${getCookie('flatlinkAuth')}`;;
                img.alt = `Carousel Image ${index + 1}`;
                img.classList.add('carouselImage');
                slide.appendChild(img);
                carouselTrack.appendChild(slide);
            });
        }

        function showImage(index) {
            carouselTrack.style.transform = `translateX(-${index * 100}%)`;
            updateDots();
        }

        function nextImage() {
            currentIndex = (currentIndex + 1) % imageSources.length;
            showImage(currentIndex);
        }

        function prevImage() {
            currentIndex = (currentIndex - 1 + imageSources.length) % imageSources.length;
            showImage(currentIndex);
        }

        function createDots() {
            imageSources.forEach((_, index) => {
                const dot = document.createElement('span');
                dot.classList.add('dot');
                dot.addEventListener('click', () => {
                    currentIndex = index;
                    showImage(currentIndex);
                });
                dotsContainer.appendChild(dot);
            });
        }

        function updateDots() {
            const dots = document.querySelectorAll('.dot');
            dots.forEach((dot, index) => {
                dot.classList.toggle('active', index === currentIndex);
            });
        }

        function handleTouchStart(event) {
            touchStartX = event.touches[0].clientX;
        }

        function handleTouchMove(event) {
            touchEndX = event.touches[0].clientX;
        }

        function handleTouchEnd() {
            if (touchStartX - touchEndX > 50) {
                nextImage();
            }
            if (touchEndX - touchStartX > 50) {
                prevImage();
            }
            touchStartX = 0;
            touchEndX = 0;
        }

        createSlides();
        createDots();
        showImage(currentIndex);

        // Add touch event listeners
        carouselContainer.addEventListener('touchstart', handleTouchStart);
        carouselContainer.addEventListener('touchmove', handleTouchMove);
        carouselContainer.addEventListener('touchend', handleTouchEnd);

        // next image every 8 seconds
        setInterval(nextImage, 8000);

        let gendPreference;
        if (provider.genderPreference == "female") gendPreference = "Nur Frauen";
        if (provider.genderPreference == "male") gendPreference = "Nur Männer";
        if (provider.genderPreference == "intersex") gendPreference = "Nur Intersex";
        if (provider.genderPreference == "none") gendPreference = "";
        $('.genderPreference .descriptionText').text(gendPreference)


        $('.price .descriptionText').text(`${provider.price} chf/monat`)


        $('.bus .descriptionText').text(`Nächster öV ${Math.round(provider.transportDistance)}m zu Fuss`)

        $('.shop .descriptionText').text(`Nächster Shop ${Math.round(provider.supermarketDistance)}m zu Fuss`)
        $('.address .descriptionText').text(`${provider.street}, ${provider.plz} ${provider.place}`)

        $('iframe').attr('src', `https://www.google.com/maps?q=${provider.latitude},${provider.longitude}&z=15&output=embed&iwloc=near`)

        $('.flatmates .descriptionText').text(`${provider.flatmates} Mitbewohner:innen`)
        
        if(provider.food !=="none"){
          provider.food == "vegan" ? $('.food .descriptionText').text(`Vegane Mitbewohner:innen`) : $('.food .descriptionText').text(`Vegetraische Mitbewohner:innen`);
        }
        if(provider.food =="none") $('.food, .foodHide').hide();

        $('.size .descriptionText').text(`${provider.roomSize} qm grosses Zimmer`)
        $('.flatsize .descriptionText').text(`${provider.flatSize} qm grosse Wohnung`)

        if(provider.internet !== true) $('.wifi .descriptionText').text(`Kein konstenloses Wifi`)
        if(provider.balcony !== true) $('.balcony .descriptionText').text(`Kein Balkon vorhanden`)
        if(provider.washer !== true) $('.laundry .descriptionText').text(`Keine Waschmaschine`)

        $('#cleanliness').parent().children('.'+numArray[Number(provider.cleanliness)-1]).addClass('selected');


        $('#atmosphere').parent().children('.'+numArray[Number(provider.quietness)-1]).addClass('selected')


        $('#accessibility').parent().children('.'+numArray[Number(provider.accessibility)-1]).addClass('selected')

        $('#accessibility').parent().children('.'+numArray[Number(provider.accessibility)-1]).addClass('selected')

        $('.descriptionDescriptionText').text(provider.description)
    };

    </script>