<div class="topTitle title topTitleSettings">eMail Adresse</div>
    
    
<div class="foreground">
    <div class="foregroundTop">
        <div class="oval"></div>
    </div>
    <div class="innerForeground">
    <form id="mainForm" method="post" action=""> 
        <div class="message orangeShadowNoOffset">
        </div>
        <label class="inputLabel" for="job">Deine eMail</label>
        <div class="spacing1"></div>
        <input type="email" name="email" required placeholder="Neue eMail"
        onchange="$(this).css('border', '1px solid var(--inputBorder)');"
        oninvalid=" $(this).css('border', '1px solid red');" id="eMail" autocomplete="email">
        <div class="spacing5"></div>
           <div class="spacing5"></div>
           <div class="info">
            <img src="/assets/svg/info.svg" alt="">
            <div class="infoText">
                
                Deine eMail Adresse kannst Du ein Mal innert 24 Stunden ändern.
            </div>
        </div>
        <div class="spacing8"></div>

           <div class="buttonDiv button submitButton" data-onclick="$('#submitButton').click()" onclick="$('#submitButton').click();">
               <div class="buttonText">Ändern</div>
               </div>
           <input type="submit" id="submitButton" value="submit" style="display: none;">

    </form>


        
    <div class="spacing5"></div>
    <div class="spacing3"></div>

</div>
</div>