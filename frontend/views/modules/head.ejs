<div class="cookieNoticeBackground" style="display: none;">
  <div class="cookieNotice loginNotice">
    <center>

      <div class="warningSymbol">
        <img src="/assets/svg/cookie.svg" alt="">
      </div>
      <p class="grayShadowNoOffset">Auf dieser Webseite kommen keine einwilligungsbedürftige Cookies zum Einsatz.  
        Ein Cookie wird benutzt, um Deine Login-Daten zu speichern.</p>

      <div class="footerText"><a href="/datenschutz" target="_blank">Datenschutzerklärung</a> · <a href="/impressum"
          target="_blank">Impressum</a>
      </div> <br>
    </center>

    <div id="dismiss-cookie-notice" class="dismiss-cookie-notice buttonDiv button">Na supa</div>

  </div>
</div>

<div class="cookieNoticeBackground errorOverlay" style="display: none;">
  <div class="cookieNotice loginNotice">
    <center>

      <div class="warningSymbol">
        <img src="/assets/svg/noCloud.svg" alt="">
      </div>
      <p class="grayShadowNoOffset">Wir können momentan keine Informationen von unseren Servern abluchsen. Bitte versuch's später nochmals.</p>

    </center>

    <div class="buttonDiv button" onclick="document.querySelector('.errorOverlay').style.display = 'none';">Okay🙄</div>

  </div>
</div>

<script defer>
      if (!localStorage.getItem('cookieNoticeAccepted')) {
     if(document.location.pathname !== "/datenschutz" && document.location.pathname !==  "/impressum") {
          // If the notice has not been accepted, display it

     document.querySelector('.cookieNoticeBackground').style.display = 'flex';
     }
   }
</script>