<!DOCTYPE html>
<%- include('./modules/head', {title:"eMail verification"}) %>

    <body>
        <div class="content">
            <div class="spacing10"></div>
            <div class="spacing10"></div>
            <div class="spacing10"></div>
            <div class="spacing10"></div>

            <div class="lds-ripple hideSuccess hideError">
                <div></div>
                <div></div>
              </div>
              <div class="errorPart" style="display: none;">
                
            <img src="assets/svg/cancelRed.svg" alt="" class="topCenterLogo">
            <p class="bigCenterTitle title">
               Nahhhh
            </p>
            <div class="spacing10">
            </div>
            <div class="info">
                <img src="/assets/svg/info.svg" alt="">
                <div class="infoText">
                    Bitte fordere einen neuen Link auf Deiner Account-Seite an
                </div>
            </div>
           
            <div class="spacing10">
            </div>
            <a href="/user/account">
            <div class="buttonDiv button submitButton" data-onclick="$('#submitButton').click()" onclick="">
                <div class="buttonText">Zrück zum Account</div>
                </div>
            </a>

            </div>
            <div class="successPart" style="display: none;">
                <img src="assets/svg/checkGreen.svg" alt="" class="topCenterLogo">
            <p class="bigCenterTitle title">
               Wohooo!
            </p>
            <div class="spacing10">
            </div>
            <div class="spacing10">
            </div>
            <a href="/user">

            <div class="buttonDiv button submitButton" data-onclick="$('#submitButton').click()" onclick="$('#submitButton').click();">
                <div class="buttonText">Zrück zu flatlink</div>
                </div>
            </a>
                </div>
        </div>
        <%- include('./modules/footer', { minHeight: 0.5, hide: false}) %>

    </body>

    </html>

    <script>

$.ajax({
    url: '<%=process.env.apiUrl%>/accountService/verifyEmail',
    type: 'POST',
    async: true,
    cache: false,
    crossDomain: true,
    data: {
        "token": '<%=token%>'
    },
    success: function (data, status, xhr) {
        if (data) {
            $('.hideSuccess').hide()
       if (data.success == true) {
        $('.successPart').show()
       }
       if(data.success == false){
        $('.errorPart').show()

       }
    }
}
    }
    )
    </script>