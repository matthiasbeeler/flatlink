




<!DOCTYPE html>
<%- include('./modules/head', {title:"Account"}) %>

    <body>
        <div class="content">
            <a href="/user/account" class="backButtonLink">
            <div class="backButton">
                <img src="/assets/svg/backIcon.svg" alt="">
            </div>
        </a>
        <div class="topTitle title topTitleSettings passwordTitle">Passwort vergessen🔒</div>
    
    
        <div class="foreground">
            <div class="foregroundTop">
                <div class="oval"></div>
            </div>
            <div class="innerForeground">
            <form id="mainForm" method="post" action=""> 
                <div class="message orangeShadowNoOffset">
                </div>
                <label class="inputLabel" for="job">Deine eMail</label>
                <div class="spacing1"></div>
                <input type="email" name="email" required placeholder="Deine eMail"
                onchange="$(this).css('border', '1px solid var(--inputBorder)');"
                oninvalid=" $(this).css('border', '1px solid red');" id="eMail" autocomplete="email">
                <div class="spacing5"></div>
                   <div class="spacing5"></div>
                   <div class="info" style="display: none;">
                    <img src="/assets/svg/checkGreen.svg" alt="">
                    <div class="infoText">
                        
                        Falls Deine eMail in unserem System registriert ist, bekommst Du eine eMail um Dein Passwort zu resetten.
                    </div>
                </div>
                <div class="spacing8"></div>
        
                   <div class="buttonDiv button submitButton" data-onclick="$('#submitButton').click()" onclick="$('#submitButton').click();">
                       <div class="buttonText">Anfragen</div>
                       </div>
                   <input type="submit" id="submitButton" value="submit" style="display: none;">
        
            </form>
        
        
                
            <div class="spacing5"></div>
            <div class="spacing3"></div>
        
        </div>
        </div>
        

    </div>

        <%- include('./modules/footer', { minHeight: 0.6, hide: true}) %>

    </body>

    </html>
    <script>
$("#mainForm").submit(function(e) {
        e.preventDefault();
        $(".submitButton").addClass('buttonLoading');
        $('.submitButton').attr('onclick', '');
            var formdata = new FormData(document.querySelector('#mainForm'));
            formdata.append('flatlinkAuth', getCookie('flatlinkAuth'));
           

        $.ajax({
            url: '<%=process.env.apiUrl%>/accountService/passwordForgotten',
            type: 'POST',
            cache: false,
            processData: false,  // Prevent jQuery from processing the data
            contentType: false, 
            crossDomain: true,
            data: formdata,
            success: function (data) {
                if (data.success == true) {
                    $('input').attr('disabled', true);
                    $('.info').show()
                    $('.submitButton').attr('onclick', '');
                    $('.submitButton, input').addClass('disabled')

                }
                if (data.success == false) {
                    $('.submitButton').attr('onclick', $('.submitButton').data('onclick'));
                    $(".submitButton").removeClass('buttonLoading');
                    $(".button").show();
                    $('.message').show()
                    $('.message').html(data.message)
                }
            },
            error: function(xhr){
                $('.submitButton').attr('onclick', $('.submitButton').data('onclick'));

        alert('Request Status: ' + xhr.status + ' Status Text: ' + xhr.statusText + ' ' + xhr.responseText);
    }
        });

    })


    </script>