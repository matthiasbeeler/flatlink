}

        function saveChanges() {
            const button = document.querySelector('.button');
            button.classList.add('buttonLoading');

            const updatedData = {
                userData: {
                    firstName: document.getElementById('firstName').value,
                    lastName: document.getElementById('lastName').value,
                    email: document.getElementById('email').value,
                    phonenumber: document.getElementById('phonenumber').value
                },
                preferences: gatherPreferencesData()
            };

            $.ajax({
                url: '<%=process.env.apiUrl%>/adminService/updateUserData',
                type: 'POST',
                data: {
                    ...updatedData,
                    id: "<%=userId%>",
                    userType: "<%=userType%>",
                    flatlinkAuth: getCookie('flatlinkAuth')
                },
                success: function(response) {
                    button.classList.remove('buttonLoading');
                    if (response.success) {
                        showMessage('Changes saved successfully');
                        loadUserData();
                    } else {
                        showError('Failed to save changes');
                    }
                },
                error: function() {
                    button.classList.remove('buttonLoading');
                    showError('Error saving changes');
                }
            });
        }

        function gatherPreferencesData() {
            const preferences = {};
            const container = document.getElementById('preferencesContainer');
            
            container.querySelectorAll('[id^="pref_"]').forEach(element => {
                const key = element.id.replace('pref_', '');
                let value;

                if (element.classList.contains('selectInput')) {
                    value = element.querySelector('.selected').dataset.value;
                    if (value === 'true') value = true;
                    if (value === 'false') value = false;
                } else if (element.type === 'number') {
                    value = parseFloat(element.value);
                } else if (element.tagName === 'TEXTAREA' && key !== 'description') {
                    try {
                        value = JSON.parse(element.value);
                    } catch (e) {
                        console.error('Invalid JSON in', key);
                        value = element.value;
                    }
                } else {
                    value = element.value;
                }

                preferences[key] = value;
            });

            return preferences;
        }

        function formatLabel(key) {
            return key
                .replace(/([A-Z])/g, ' $1')
                .replace(/^./, str => str.toUpperCase());
        }

        function showMessage(message) {
            const messageElement = document.querySelector('.message');
            messageElement.classList.remove('errorMessage');
            messageElement.style.display = 'block';
            messageElement.querySelector('.messageText').textContent = message;
            setTimeout(() => {
                messageElement.style.display = 'none';
            }, 3000);
        }

        function showError(message) {
            const messageElement = document.querySelector('.message');
            messageElement.classList.add('errorMessage');
            messageElement.style.display = 'block';
            messageElement.querySelector('.messageText').textContent = message;
            setTimeout(() => {
                messageElement.style.display = 'none';
            }, 3000);
        }

        // Initial load
        loadUserData();
    </script>

