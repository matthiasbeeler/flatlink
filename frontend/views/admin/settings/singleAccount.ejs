<!DOCTYPE html>
<%- include('../../modules/head', {title:"User Management"}) %>

<body>
    <div class="content">
        <a href="/admin/settings/userAccounts" class="backButtonLink">
            <div class="backButton">
                <img src="/assets/svg/backIcon.svg" alt="">
            </div>
        </a>
        
        <p class="smallTitleSide">User Details</p>

        <!-- User Basic Info Section -->
        <div class="accountTopSection">
            <div class="profileImage" id="userImage">
                <img src="/assets/images/defaultProfile.jpg" alt="Profile">
            </div>
            <div class="accountDetails">
                <div class="nameDetail" id="userName"></div>
                <div class="occupationDetail" id="userEmail"></div>
                <div class="occupationDetail" id="userPhone"></div>
            </div>
        </div>

        <div class="spacing3"></div>

        <!-- Basic User Info -->
        <p class="inputLabel">Basic Information</p>
        <input type="text" id="firstName" placeholder="First Name">
        <div class="spacing3"></div>
        <input type="text" id="lastName" placeholder="Last Name">
        <div class="spacing3"></div>
        <input type="email" id="email" placeholder="Email">
        <div class="spacing3"></div>
        <input type="tel" id="phonenumber" placeholder="Phone">

        <div class="spacing3"></div>
        <div class="seperator"></div>
        <div class="spacing3"></div>

        <!-- Preferences Section -->
        <p class="inputLabel">Preferences</p>
        <div id="preferencesContainer">
            <!-- Dynamically populated -->
        </div>

        <!-- For Providers: Images Section -->
        <div id="imagesSection" style="display: none;">
            <div class="spacing3"></div>
            <div class="seperator"></div>
            <div class="spacing3"></div>
            
            <p class="inputLabel">Apartment Images</p>
            <div class="carouselContainer grayShadowBoldNoOffset">
                <div class="carouselTrack" id="imageCarousel">
                    <!-- Images will be populated here -->
                </div>
                <div class="dots" id="imageDots"></div>
            </div>
        </div>

        <!-- Match History -->
        <div class="spacing3"></div>
        <div class="seperator"></div>
        <div class="spacing3"></div>

        <p class="inputLabel">Match History</p>
        <div id="matchLogsContainer"></div>

        <!-- Save Button -->
        <div class="spacing5"></div>
        <div class="button buttonDiv" onclick="saveChanges()">
            <div class="buttonText">Save Changes</div>
        </div>
        <div class="spacing5"></div>

        <div class="message errorMessage grayShadowBoldNoOffset">
            <div class="messageText"></div>
        </div>
    </div>

    <script>
        let currentUserData = null;
        let currentSlide = 0;

        // Replace the displayUserData function with this corrected version:
function displayUserData(data) {
    // Basic user info
    document.getElementById('userName').textContent = 
        `${data.userData.firstName} ${data.userData.lastName}`;
    document.getElementById('userEmail').textContent = data.userData.email;
    document.getElementById('userPhone').textContent = data.userData.phonenumber;

    // Form fields
    document.getElementById('firstName').value = data.userData.firstName;
    document.getElementById('lastName').value = data.userData.lastName;
    document.getElementById('email').value = data.userData.email;
    document.getElementById('phonenumber').value = data.userData.phonenumber;

    // Determine which preferences object to use based on user type
    const preferences = "<%=userType%>" === "searcher" ? data.searcher : data.provider;
    
    if (preferences) {
        displayPreferences(preferences);
        
        // Show images section for providers
        if ("<%=userType%>" === "provider" && preferences.images) {
            setupImageCarousel(preferences.images);
        }
    } else {
        showError('No preferences found for this user');
    }

    // Display match logs if they exist
    if (data.matchLogs && data.matchLogs.length > 0) {
        displayMatchLogs(data.matchLogs);
    } else {
        document.getElementById('matchLogsContainer').innerHTML = `
            <div class="message errorMessage grayShadowBoldNoOffset" style="display: block;">
                <div class="messageText">No matches found</div>
            </div>
        `;
    }
}

// Add better error handling to loadUserData:
async function loadUserData() {
    try {
        const response = await $.ajax({
            url: '<%=process.env.apiUrl%>/adminService/getUserData',
            type: 'POST',
            data: {
                id: "<%=userId%>",
                userType: "<%=userType%>",
                flatlinkAuth: getCookie('flatlinkAuth')
            }
        });

        console.log('Response:', response); // For debugging

        if (response.success) {
            currentUserData = response;
            $('#userImage').children('img').attr('src', `<%=process.env.apiUrl%>/accountService/uploads/searcherImages/<%=userId%>?flatlinkAuth=${getCookie('flatlinkAuth')}`)
            displayUserData(response);
        } else {
            showError(response.error || 'Failed to load user data');
        }
    } catch (error) {
        console.error('Error loading user data:', error);
        showError('Failed to load user data: ' + (error.message || 'Unknown error'));
    }
}

// Update displayMatchLogs to handle the data structure correctly:
function displayMatchLogs(logs) {
    const container = document.getElementById('matchLogsContainer');
    container.innerHTML = '';

    if (!logs || logs.length === 0) {
        container.innerHTML = `
            <div class="message errorMessage grayShadowBoldNoOffset" style="display: block;">
                <div class="messageText">No matches found</div>
            </div>
        `;
        return;
    }

    logs.forEach(log => {
        const matchIcon = log.matchType ? 
            '/assets/svg/heartGreenLight.svg' : 
            '/assets/svg/heartBrokenRedLight.svg';

        // Add details based on user type
        const details = "<%=userType%>" === "provider" ?
            `${log.User ? `Matched with ${log.User.firstName} ${log.User.lastName}` : 'Unknown user'}` :
            `${log.providerPreference ? `Matched with ${log.providerPreference.street}, ${log.providerPreference.place}` : 'Unknown property'}`;

        container.innerHTML += `
            <div class="likeElement grayShadowBoldNoOffset">
                <div class="buttonIcon">
                    <img src="${matchIcon}" alt="${log.matchType ? 'Like' : 'Dislike'}">
                </div>
                <div class="textContent">
                    <div class="likeAddress">${details}</div>
                    <div class="likeInfo">${new Date(log.createdAt).toLocaleDateString()}</div>
                </div>
            </div>
            <div class="spacing3"></div>
        `;
    });
}

