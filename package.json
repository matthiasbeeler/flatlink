        "debug": "~2.6.9",
        "ejs": "~2.6.1",
        "express": "~4.16.1",
        "http-errors": "~1.6.3",
        "morgan": "~1.9.1",
        "run-all": "^1.0.1",
        "serve-favicon": "^2.5.0",
        "sqlite3": "^5.1.7"
    },
    "devDependencies": {
        "npm-run-all": "^4.1.5"
    }
}
